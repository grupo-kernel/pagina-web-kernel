{
  "schema_version": 1,
  "core_version": "0.3.0",
  "status": "parallel-not-active",
  "public_site_untouched": true,
  "default_locale": "es",
  "supported_locales": ["es", "en"],
  "sources": {
    "researchers": {
      "active_path": "data/researchers.json",
      "candidate_path": "core/data/researchers.v2.json",
      "required": true,
      "migration_status": "candidate-created-not-active",
      "validation": "core/validate-researchers-v2.js",
      "audit": "core/audits/researchers-audit.md",
      "consumers": ["home", "team", "academic-background", "publications", "projects"]
    },
    "publications": {
      "path": "data/publications.json",
      "candidate_path": "core/data/publications.v2.json",
      "required": true,
      "migration_status": "candidate-generated-not-active",
      "consumers": ["home", "publications", "researcher-profile"]
    },
    "projects": {
      "candidate_path": "core/data/projects.v2.json",
      "required": false,
      "migration_status": "candidate-created-not-active",
      "consumers": ["home", "projects", "researcher-profile"]
    },
    "services": {
      "candidate_path": "core/data/services.v2.json",
      "required": false,
      "migration_status": "candidate-created-not-active",
      "consumers": ["home", "services", "contact"]
    },
    "news": {
      "candidate_path": "core/data/news.v2.json",
      "required": false,
      "migration_status": "candidate-created-not-active",
      "consumers": ["home", "news"]
    },
    "translations_es": {
      "path": "translations/es.json",
      "required": false,
      "migration_status": "candidate-created-not-active",
      "consumers": ["all"]
    },
    "translations_en": {
      "path": "translations/en.json",
      "required": false,
      "migration_status": "candidate-created-not-active",
      "consumers": ["all"]
    }
  },
  "activation": {
    "enabled": false,
    "strategy": "module-by-module",
    "next_candidate": "team",
    "rollback": "remove module import and retain current renderer",
    "modules": {
      "team": {
        "active": false,
        "status": "preview-ready",
        "source": "core/data/researchers.v2.json",
        "renderer": "core/modules/team/team-renderer.mjs",
        "preview": "core/modules/team/team-preview.html",
        "validator": "core/validate-team-module.mjs",
        "rollback": "keep current production Team component and do not import Kernel Core renderer"
      },
      "academic-background": { "active": false, "status": "pending" },
      "publications": { "active": false, "status": "pending" },
      "projects": { "active": false, "status": "pending" },
      "services": { "active": false, "status": "pending" },
      "news": { "active": false, "status": "pending" }
    }
  }
}
